{
  "manifest_version": 3,
  "name": "Vemo",
  "version": "1.0.0",
  "description": "Assista YouTube e Netflix em sincronia com outra pessoa: pausou aqui, pausa lá.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://*.youtube.com/*", "https://*.netflix.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Vemo",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content/sync-core.js", "content/adapters/youtube.js", "content/main.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content/sync-core.js", "content/adapters/netflix.js", "content/main.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content/netflix-page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
